    <!-- Reminder templates. Args: 1 business, 2 member first name, 3 months, 4 amount, 5 pay link -->
    <string name="tpl_en_gentle">Hello 👋\nA gentle reminder from %1$s: the fee of %4$s for %2$s (%3$s) is due.\nPay in one tap by UPI: %5$s\nIf you have already paid, please ignore this message. Thank you!</string>
    <string name="tpl_en_firm">Hello,\n%1$s: the fee of %4$s for %2$s (%3$s) is still pending. Please clear it today.\nPay by UPI: %5$s\nThank you.</string>
    <string name="tpl_hinglish_gentle">Namaste 🙏\n%1$s: %2$s ki %3$s ki fees %4$s due hai.\nEk click mein UPI se pay karein: %5$s\nAgar payment ho gaya hai toh is message ko ignore karein. Thank you!</string>
    <string name="tpl_hinglish_firm">Namaste 🙏\n%1$s: %2$s ki %3$s ki fees %4$s abhi tak pending hai. Kripya aaj payment kar dijiye.\nUPI se pay karein: %5$s\nDhanyavaad</string>
    <string name="tpl_hi_gentle">नमस्ते 🙏\n%1$s: %2$s की %3$s की फीस %4$s देय है।\nएक क्लिक में UPI से भुगतान करें: %5$s\nअगर भुगतान हो गया है तो कृपया इस संदेश को अनदेखा करें। धन्यवाद!</string>
    <string name="tpl_hi_firm">नमस्ते 🙏\n%1$s: %2$s की %3$s की फीस %4$s अभी तक बाकी है। कृपया आज भुगतान कर दें।\nUPI से भुगतान करें: %5$s\nधन्यवाद</string>
    <!-- Args: 1 business, 2 amount, 3 member first name, 4 month, 5 receipt link -->
    <string name="tpl_receipt">Payment received ✅\n%1$s: %2$s for %3$s (%4$s).\nReceipt: %5$s\nThank you!</string>

